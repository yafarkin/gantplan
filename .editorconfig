root = true

# Отступы и переводы строк - как уже принято в репозитории (все файлы LF).
# charset, trim_trailing_whitespace и insert_final_newline намеренно не
# заданы: в репозитории есть файлы и с BOM, и без, с хвостовыми пробелами и
# без финального перевода строки - редактор переписывал бы их при каждом
# сохранении, и в диффах появлялся бы шум в несвязанных строках.
[*]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
# Стиль кода - только подсказки в IDE, на сборку не влияет.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# Приватные поля экземпляра - _camelCase.
dotnet_naming_rule.private_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# Константы и static readonly - PascalCase (MaxHorizon, DefaultWeights).
# Правила с модификаторами специфичнее и применяются раньше правила
# про _camelCase выше.
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = suggestion

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_pascal.severity = suggestion

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case
